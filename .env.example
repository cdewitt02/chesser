# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Nothing loads this file automatically — source it before running:
#     . ./.env

# PostgreSQL connection string (required)
export DATABASE_URL="postgres://user:pass@localhost:5432/chesser?sslmode=disable"

# Required only when CHAT_PROVIDER=anthropic.
# Create one at https://console.anthropic.com/
export ANTHROPIC_API_KEY=""

# Provider selection. Both default to ollama, which needs no account and no
# network. Chat and embeddings are chosen independently because Anthropic has
# no embeddings API.
# export CHAT_PROVIDER=ollama    # ollama | anthropic
# export EMBED_PROVIDER=ollama   # ollama

# Models. The positional CLI argument to cmd/chat outranks CHAT_MODEL.
# export CHAT_MODEL=             # default: llama3.2 / claude-opus-5
# export EMBED_MODEL=            # default: nomic-embed-text; must emit 768 dimensions

# export OLLAMA_URL=http://localhost:11434
# export NUM_WORKERS=4

# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Nothing loads this file automatically — source it before running:
#     . ./.env

# The host port docker-compose.yml publishes. Change it here and DATABASE_URL
# below follows, because the two have to agree and nothing checks that they do.
# docker compose reads this file too, so `docker compose up -d` picks it up
# without the variable being exported on the command line.
export CHESSER_DB_PORT=5432

# PostgreSQL connection string (required). The credentials are the ones
# docker-compose.yml sets; change them only if you brought your own PostgreSQL.
export DATABASE_URL="postgres://chesser:chesser@localhost:${CHESSER_DB_PORT}/chesser?sslmode=disable"

# Required only when CHAT_PROVIDER=anthropic.
# Create one at https://console.anthropic.com/
export ANTHROPIC_API_KEY=""

# Required when CHAT_PROVIDER=openai or EMBED_PROVIDER=openai.
# Create one at https://platform.openai.com/api-keys
export OPENAI_API_KEY=""

# Provider selection. Both default to ollama, which needs no account and no
# network. Chat and embeddings are chosen independently because Anthropic has
# no embeddings API.
# Setting both to openai is what removes Ollama from the prerequisite list.
# export CHAT_PROVIDER=ollama    # ollama | anthropic | openai
# export EMBED_PROVIDER=ollama   # ollama | openai

# Models. The positional CLI argument to cmd/chat outranks CHAT_MODEL.
# export CHAT_MODEL=             # default: llama3.2 / claude-opus-5 / gpt-5-2025-08-07
# export EMBED_MODEL=            # default: nomic-embed-text / text-embedding-3-small
#                                # whichever model is chosen must emit 768 dimensions

# export OLLAMA_URL=http://localhost:11434
# export NUM_WORKERS=4
